{
  "name": "triage-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "spec:check": "node scripts/check-spec.mjs",
    "verify": "npm run typecheck && npm run lint && npm run spec:check && npm test && npm run build",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "triage-bot": "node --experimental-strip-types scripts/triage-bot.ts"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "next": "16.4.0",
    "posthog-js": "^1.438.7",
    "posthog-node": "^5.55.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "js-yaml": "5.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "An agent that investigates open GitHub issues with tools and rules on them.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgeorgie/triage-desk.git"
  }
}
