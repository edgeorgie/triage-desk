# Optional product analytics (PostHog). Everything is off until a key is set; see docs/adr/0003.
#
# Web app: a public project token, inlined at build time. Leave the host unset on Vercel so events
# go through /ingest on this origin. The GitHub Pages export has no proxy: set the host there too
# (npm run deploy:pages reads it and allows it in the content security policy).
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
#
# Bot (scripts/triage-bot.ts): read at run time; in GitHub Actions it comes from the POSTHOG_KEY secret.
POSTHOG_KEY=
#
# In the PostHog project settings, enable "Discard client IP data": the browser SDK's own `ip`
# option has no effect.
